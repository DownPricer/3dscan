generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
}

enum ModelType {
  GLB
  GLTF
  OBJ
  ZIP
}

enum VisitType {
  MODEL_3D
  PANORAMA_360
  HYBRID_3D_360
  MATTERPORT
}

enum MatterportImportMode {
  EMBED
  MATTERPAK_OBJ
  MATTERPAK_UNKNOWN
  LOCAL_BACKUP_VIEWER
}

enum MatterportImportStatus {
  NONE
  PENDING
  READY
  READY_PARTIAL
  UNSUPPORTED
  ERROR
}

enum ExternalStatus {
  ONLINE
  OFFLINE
  CHECK_ERROR
  UNKNOWN
}

enum CatalogStatus {
  DRAFT
  ONLINE
  EXTERNAL_DOWN
  HIDDEN
  SOLD
}

enum ListingType {
  SALE
  RENT
}

enum ExternalListingSource {
  LEBONCOIN
  OTHER
}

enum ExternalListingStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  CHECK_ERROR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}

model Property {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  address        String?
  city           String?
  postalCode     String?
  price          Int?
  description    String?
  coverImageUrl  String?
  modelUrl       String
  modelType      ModelType
  visitType      VisitType       @default(MODEL_3D)
  matterportUrl            String?
  matterportEmbedUrl       String?
  matterportModelId        String?
  matterportImportMode     MatterportImportMode?
  matterportZipOriginalName String?
  matterportImportStatus   MatterportImportStatus @default(NONE)
  matterportImportError    String?
  matterportLocalManifestUrl String?
  matterportAuditReportUrl   String?
  matterportAuditSummary     Json?
  status         PropertyStatus  @default(DRAFT)
  catalogEnabled      Boolean        @default(false)
  catalogStatus       CatalogStatus  @default(DRAFT)
  catalogTitle        String?
  catalogSubtitle     String?
  catalogPriceLabel   String?
  catalogCityLabel    String?
  catalogDescription  String?
  catalogPrice        Int?
  listingType         ListingType     @default(SALE)
  catalogCity         String?
  catalogPostalCode   String?
  catalogSurface      Int?
  catalogRooms        Int?
  catalogBedrooms     Int?
  catalogLandSurface  Int?
  catalogPropertyType String?
  catalogTags         String[]       @default([])
  catalogFeatured     Boolean        @default(false)
  catalogSortOrder    Int            @default(0)
  externalUrl            String?
  externalSource         String?
  externalStatus         ExternalStatus @default(UNKNOWN)
  externalLastCheckedAt  DateTime?
  externalLastHttpStatus Int?
  externalLastError      String?
  catalogCoverImageUrl     String?
  externalListingUrl       String?
  externalListingSource    ExternalListingSource?
  externalListingStatus    ExternalListingStatus @default(UNKNOWN)
  externalLastStatusCode   Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  panoramaScenes PanoramaScene[]
  hotspots       Hotspot[]
}

model PanoramaScene {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  imageUrl   String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  hotspots   Hotspot[]
}

model Hotspot {
  id              String         @id @default(cuid())
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label           String
  x               Float
  y               Float
  z               Float
  panoramaSceneId String?
  panoramaScene   PanoramaScene? @relation(fields: [panoramaSceneId], references: [id], onDelete: SetNull)
}
