# Copier sur le VPS : cp deploy/.env.example /opt/3dscan/.env && nano /opt/3dscan/.env

# --- PostgreSQL (conteneur 3dscan-db, isolé de la DB VTC) ---
POSTGRES_USER=scan
POSTGRES_PASSWORD=remplacer_par_mot_de_passe_fort
POSTGRES_DB=site_ready_scan

# DATABASE_URL est construit dans docker-compose.yml (host db:5432)

# --- Next.js / auth ---
AUTH_SECRET=remplacer_openssl_rand_hex_32
NEXT_PUBLIC_APP_URL=https://visitevirtuel.sitereadyshd.fr
NEXT_PUBLIC_VISIT_BASE_URL=https://visitevirtuel.sitereadyshd.fr/visite

UPLOAD_PROVIDER=local
UPLOAD_MAX_SIZE_MB=250

# --- Premier admin (npm run db:seed dans le conteneur) ---
ADMIN_EMAIL=admin@sitereadyshd.com
ADMIN_PASSWORD=remplacer_mot_de_passe_admin
