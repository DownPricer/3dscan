# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/site_ready_shd?schema=public"

# Secret long et aléatoire pour signer les sessions admin
AUTH_SECRET="remplacez-par-une-valeur-longue-et-secrete"

# URL publique du site principal
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# En local : /visite/[slug]
# VPS SiteReady Scan : https://scan.sitereadyshd.fr/visite
NEXT_PUBLIC_VISIT_BASE_URL="http://localhost:3000/visite"

# Stockage fichiers: local pour le dev. S3/Supabase peuvent être branchés dans lib/storage.ts
UPLOAD_PROVIDER="local"
UPLOAD_MAX_SIZE_MB="250"

# Seed du premier admin
ADMIN_EMAIL="admin@sitereadyshd.com"
ADMIN_PASSWORD="changez-moi-vite"
