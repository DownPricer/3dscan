# Documentation des variables utiles — 3DLiveScanner / SiteReady Scan
# Copier vers .env uniquement en local si besoin ; ne jamais committer .env

# --- Build Android (poste de dev) ---
# JAVA_HOME=C:\Program Files\Android\Android Studio\jbr
# ANDROID_HOME=C:\Users\YOU\AppData\Local\Android\Sdk

# --- Processeur PC / Meshroom (Windows ou Linux) ---
# Chemin vers le dossier contenant meshroom.exe ou meshroom_batch
# MESHROOM_DIR=C:\Program Files\Meshroom
# MESHROOM_HOME=C:\Program Files\Meshroom

# --- Preview locale (generee par export_pipeline.py, dev uniquement) ---
# PREVIEW_PORT=8765

# --- Site web Visitevirtuel (projet SEPARE, pas ce repo) ---
# NEXT_PUBLIC_APP_URL=https://scan.siteready.fr
# DATABASE_URL=postgresql://...
# UPLOAD_MAX_SIZE_MB=250
